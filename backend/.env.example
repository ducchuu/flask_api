
# Sign the auth tokens. should be long
SECRET_KEY= random_string

DATABASE=pulse.db

# Run with recorded fixture data instead of hitting the real APIs 
FIXTURE_MODE=1

# External content APIs
GNEWS_API_KEY=
YOUTUBE_API_KEY=
# Lemmy is a public API and needs no key

# Google OAuth: same client id as frontend/js/config.js, used to verify sign-ins
GOOGLE_CLIENT_ID=
